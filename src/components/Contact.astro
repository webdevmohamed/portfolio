---
import { getDict, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
---

<section id="contact" class="relative flex min-h-svh flex-col justify-between overflow-hidden border-t border-line gutter pt-24 pb-8 md:pt-36" data-contact>
  <div class="pointer-events-none absolute -left-[4vw] bottom-[6vh] select-none font-display text-[30vw] leading-none font-bold text-ink/[0.025]" aria-hidden="true">
    @@
  </div>

  <div>
    <p class="label">{t.contact.label}</p>
    <h2 class="mt-10 font-display text-[clamp(3rem,11vw,10rem)] leading-[0.95] font-semibold tracking-tight">
      <span class="block" data-reveal>{t.contact.title.split(' ')[0]}</span>
      <span class="block text-stroke-acid" data-reveal>{t.contact.title.split(' ').slice(1).join(' ') || '­'}</span>
    </h2>
    <p class="mt-6 max-w-md text-smoke" data-fade>{t.contact.description}</p>
  </div>

  <div class="mt-16 grid gap-16 md:mt-24 md:grid-cols-12 md:gap-10">
    <!-- Interactive form -->
    <form
      class="order-2 flex flex-col gap-10 md:order-1 md:col-span-7"
      data-contact-form
      novalidate
      data-status-sent={t.contact.form.sent}
      data-status-errors={t.contact.form.fix}
      data-done-label={t.contact.form.sentShort}
    >
      <p class="label">{t.contact.form.label}</p>

      <div class="grid gap-10 sm:grid-cols-2 sm:gap-8">
        <div class="relative">
          <input
            id="cf-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder=" "
            class="peer w-full border-b border-line bg-transparent py-3 pr-2 font-body text-lg text-ink transition-colors duration-300 placeholder-transparent outline-none focus:border-acid aria-[invalid=true]:border-alert"
          />
          <label
            for="cf-name"
            class="label pointer-events-none absolute top-3 left-0 transition-all duration-300 peer-focus:top-[-1.1rem] peer-focus:text-acid peer-[:not(:placeholder-shown)]:top-[-1.1rem]"
          >
            {t.contact.form.name}
          </label>
          <p class="mt-2 hidden font-mono text-[0.62rem] tracking-[0.14em] uppercase text-alert" data-error="name">{t.contact.form.errName}</p>
        </div>

        <div class="relative">
          <input
            id="cf-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder=" "
            class="peer w-full border-b border-line bg-transparent py-3 pr-2 font-body text-lg text-ink transition-colors duration-300 placeholder-transparent outline-none focus:border-acid aria-[invalid=true]:border-alert"
          />
          <label
            for="cf-email"
            class="label pointer-events-none absolute top-3 left-0 transition-all duration-300 peer-focus:top-[-1.1rem] peer-focus:text-acid peer-[:not(:placeholder-shown)]:top-[-1.1rem]"
          >
            {t.contact.form.email}
          </label>
          <p class="mt-2 hidden font-mono text-[0.62rem] tracking-[0.14em] uppercase text-alert" data-error="email">{t.contact.form.errEmail}</p>
        </div>
      </div>

      <div class="relative">
        <textarea
          id="cf-message"
          name="message"
          rows="4"
          required
          placeholder=" "
          class="peer w-full resize-none border-b border-line bg-transparent py-3 font-body text-lg leading-relaxed text-ink transition-colors duration-300 placeholder-transparent outline-none focus:border-acid aria-[invalid=true]:border-alert"
        ></textarea>
        <label
          for="cf-message"
          class="label pointer-events-none absolute top-3 left-0 transition-all duration-300 peer-focus:top-[-1.1rem] peer-focus:text-acid peer-[:not(:placeholder-shown)]:top-[-1.1rem]"
        >
          {t.contact.form.message}
        </label>
        <p class="mt-2 hidden font-mono text-[0.62rem] tracking-[0.14em] uppercase text-alert" data-error="message">{t.contact.form.errMessage}</p>
      </div>

      <div class="flex flex-wrap items-center gap-6">
        <button type="submit" class="btn-acid" data-magnetic>
          <span data-submit-label>{t.contact.form.send}</span>
          <span aria-hidden="true">→</span>
        </button>
        <p class="label max-w-[36ch]" data-form-status aria-live="polite"></p>
      </div>
    </form>

    <!-- Direct channels -->
    <div class="order-1 flex flex-col gap-8 md:order-2 md:col-span-5">
      <!-- Email -->
      <div data-fade>
        <p class="label mb-3">{t.contact.emailLabel}</p>
        <div class="group flex flex-wrap items-center gap-4">
          <a
            href="mailto:mohamed.mortahil@gmail.com"
            class="link-underline min-w-0 font-display text-2xl font-medium break-all text-ink transition-colors hover:text-acid md:text-4xl"
            data-magnetic
          >mohamed.mortahil@gmail.com</a>
          <button
            class="label border border-line px-3 py-2 transition-all duration-300 hover:border-acid hover:text-acid"
            data-copy-email
            data-copied-text={t.contact.copied}
            aria-label={t.contact.copy}
          >
            <span data-copy-label>{t.contact.copy}</span>
          </button>
        </div>
      </div>

      <!-- Phone + socials -->
      <div class="flex flex-wrap gap-12" data-fade>
        <div>
          <p class="label mb-3">{t.contact.phoneLabel}</p>
          <a href="tel:+34632159401" class="link-underline inline-block py-2 font-mono text-sm text-ink hover:text-acid">+34 632 15 94 01</a>
        </div>
        <div>
          <p class="label mb-3">{t.contact.followLabel}</p>
          <a
            href="https://www.linkedin.com/in/mohamedmortahil"
            target="_blank"
            rel="noopener noreferrer"
            class="link-underline inline-block py-2 font-mono text-sm text-ink hover:text-acid"
          >LinkedIn ↗</a>
        </div>
      </div>

      <!-- CV downloads -->
      <div data-fade>
        <p class="label mb-3">{t.contact.cvLabel}</p>
        <div class="flex flex-wrap gap-3">
          <a href="/cv/cv-es.pdf" download class="btn-acid" data-magnetic>CV · ES ↓</a>
          <a href="/cv/cv-en.pdf" download class="btn-acid" data-magnetic>CV · EN ↓</a>
        </div>
      </div>

      <!-- Local time -->
      <div class="mt-4 flex flex-col items-start gap-1 font-mono text-[0.65rem] tracking-[0.18em] text-smoke uppercase" data-fade>
        <span>{t.contact.localTime}</span>
        <span class="text-ink" data-clock>--:--:--</span>
      </div>
    </div>
  </div>

  <div class="mt-16 flex flex-col items-start justify-between gap-6 md:mt-24 md:flex-row md:items-end" data-fade>
    <a href="#hello" class="link-underline inline-block py-2 font-mono text-[0.65rem] tracking-[0.18em] text-smoke uppercase transition-colors hover:text-acid">
      {t.contact.backTop} ↑
    </a>
  </div>

  <footer class="mt-20 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6">
    <p class="label">{t.contact.footer} © 2026</p>
    <p class="label">TALAVERA DE LA REINA · 39.96°N · 4.83°W</p>
  </footer>
</section>
