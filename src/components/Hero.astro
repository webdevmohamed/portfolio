---
import { getDict, type Locale } from '../i18n';
import { CV_DOWNLOAD_NAME } from '../data/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
const cvHref = locale === 'es' ? '/cv/cv-es.pdf' : '/cv/cv-en.pdf';
---

<!-- Bottom-anchored on mobile; top-anchored (and shorter than the viewport) on
     desktop so the skills marquee peeks above the fold on 27" displays -->
<section id="hello" class="relative flex min-h-svh flex-col justify-end overflow-hidden gutter pb-8 md:min-h-[86svh] md:justify-start md:overflow-visible md:pb-10 md:pt-32 lg:pt-44" data-hero>  <!-- Interactive globe: ambient backdrop on mobile, main visual on md+ -->
  <div
    class="pointer-events-none absolute inset-0 flex items-start justify-center pt-[2vh] opacity-60 md:inset-y-0 md:left-auto md:right-0 md:w-[46%] md:items-center md:pt-0 md:opacity-100 globe-anchor"
    aria-hidden="true"
  >
    <div class="relative h-[68vh] max-h-[86vh] w-full touch-none select-none md:h-full md:pointer-events-auto" data-globe></div>
  </div>

  <div class="flex flex-col gap-6">
    <p class="label" data-hero-fade>{t.hero.greeting} -</p>

    <h1 class="font-display font-semibold leading-[0.92] tracking-tight text-ink">
      <span class="block overflow-hidden text-[clamp(3.4rem,12.5vw,11.5rem)]" data-hero-line>
        <span data-split-chars>{t.hero.name1}</span>
      </span>
      <span class="block overflow-hidden text-[clamp(3.4rem,12.5vw,11.5rem)]">
        <span data-split-chars class="text-acid">{t.hero.name2}</span>
      </span>
    </h1>

    <div class="mt-2 flex flex-wrap items-end justify-between gap-6">
      <div class="flex flex-col gap-4">
        <p class="font-mono text-xs tracking-[0.2em] text-smoke uppercase" data-hero-fade>
          {t.hero.role}
        </p>
        <div class="flex flex-wrap items-center gap-4" data-hero-fade>
          <a href="#work" class="btn-acid" data-magnetic>{t.hero.viewWork} ↓</a>
          <a href={cvHref} download={CV_DOWNLOAD_NAME} class="label link-underline inline-flex h-11 items-center text-ink">
            {t.nav.cv}
          </a>
        </div>
      </div>

      <div class="flex flex-row items-baseline gap-4 font-mono text-[0.65rem] tracking-[0.18em] text-smoke uppercase md:gap-6 lg:flex-col lg:items-end lg:gap-1" data-hero-fade>
        <span>{t.hero.localTime}</span>
        <span class="text-ink" data-clock>--:--:--</span>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-line"></div>
</section>

<script>
  import '../scripts/globe';
</script>
