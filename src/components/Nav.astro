---
import { getDict, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);

const links = [
  { href: '#hello', label: t.nav.hello },
  { href: '#about', label: t.nav.about },
  { href: '#work', label: t.nav.work },
  { href: '#skills', label: t.nav.skills },
  { href: '#contact', label: t.nav.contact },
];
const cvHref = locale === 'es' ? '/cv/cv-es.pdf' : '/cv/cv-en.pdf';
const other: Locale = locale === 'es' ? 'en' : 'es';
---

<header class="fixed inset-x-0 top-0 z-[100]" data-nav>
  <div class="gutter flex items-center justify-between py-4 md:py-5">
    <a
      href="#hello"
      class="font-display inline-flex h-10 items-center text-lg font-semibold tracking-tight text-ink"
      data-magnetic
      aria-label={t.meta.name}
    >
      MM<span class="text-acid">©</span><span class="text-sm text-smoke">'26</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {links.map((l, i) => (
        <a
          href={l.href}
          class="label inline-flex items-center transition-colors duration-300 hover:text-acid"
          data-scramble
          data-nav-link
        >
          <span class="mr-1 text-acid/60">0{i + 1}</span>{l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={other === 'en' ? '/en/' : '/'}
        class="label inline-flex items-center border border-line px-3 py-2 transition-colors duration-300 hover:border-acid hover:text-acid"
        data-magnetic
        hreflang={other}
        aria-label={other === 'en' ? 'Switch to English' : 'Cambiar a Español'}
      >
        {other.toUpperCase()}
      </a>
      <a
        href={cvHref}
        target="_blank"
        rel="noopener"
        class="label hidden items-center border border-acid/60 px-3 py-2 text-acid transition-all duration-300 hover:bg-acid hover:text-void sm:inline-flex"
        data-magnetic
      >
        CV ↓
      </a>
      <button
        class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 border border-line lg:hidden"
        data-burger
        aria-label="Menu"
        aria-expanded="false"
      >
        <span class="block h-px w-5 bg-ink transition-all duration-300" data-burger-line></span>
        <span class="block h-px w-5 bg-ink transition-all duration-300" data-burger-line></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu: rendered OUTSIDE the header on purpose — the header gets an
     inline transform from the GSAP intro, and any transformed ancestor becomes
     the containing block for position:fixed, which would clip this overlay. -->
<div
  class="fixed inset-0 z-[99] flex flex-col justify-center bg-void/98 px-8 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  data-mobile-menu
>
    <nav class="flex flex-col gap-6" aria-label="Mobile">
      {links.map((l, i) => (
        <a
          href={l.href}
          class="font-display text-5xl font-semibold text-ink transition-colors hover:text-acid"
          data-mobile-link
        >
          <span class="mr-3 font-mono text-sm text-acid/60">0{i + 1}</span>{l.label}
        </a>
      ))}
      <a
        href={cvHref}
        target="_blank"
        rel="noopener"
        class="btn-acid mt-6 w-fit"
        data-mobile-link
      >
        CV ↓
      </a>
    </nav>
</div>
