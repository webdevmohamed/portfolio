---
import { getDict, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
---

<div id="preloader" data-preloader>
  <div class="shutter-cover" data-shutter-cover></div>
  <div class="shutter" data-shutter></div>

  <div class="relative z-10 flex w-full items-end justify-between">
    <div class="flex flex-col gap-2">
      <span class="label">{t.preloader.hint}</span>
      <span class="label flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-acid animate-pulse-dot"></span>
        {t.preloader.loading}
      </span>
    </div>
    <div class="font-display text-[clamp(4rem,14vw,10rem)] leading-none font-semibold text-ink" data-counter>
      00
    </div>
  </div>

  <button
    data-enter
    class="btn-acid pointer-events-none absolute right-[clamp(1.5rem,4vw,3rem)] bottom-[clamp(1.5rem,4vw,3rem)] opacity-0 z-10"
  >
    {t.preloader.enter}
  </button>
</div>
