---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { getDict, type Locale } from '../i18n';
import { EMAIL } from '../data/site';
import clashDisplay600 from '../assets/fonts/clash-display-600.woff2?url';
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import jetbrainsMonoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  locale: Locale;
  lang: 'es' | 'en';
}

const { locale, lang } = Astro.props;
const t = getDict(locale);
const other: Locale = locale === 'es' ? 'en' : 'es';

// Canonical URLs (single source of truth: astro.config site)
const SITE = Astro.site ?? new URL('https://morta.vercel.app');
const SITE_URL = SITE.href.replace(/\/$/, '');
const canonical = locale === 'es' ? `${SITE_URL}/` : `${SITE_URL}/en/`;
const alternateHref = locale === 'es' ? `${SITE_URL}/en/` : `${SITE_URL}/`;
const ogImage = `${SITE_URL}/og.png`;
const ogImageAlt = `${t.meta.name} — ${t.meta.role}`;

// ------------------------------------------------------------------
// JSON-LD: structured data for search engines AND answer engines
// (Google rich results + AI overviews / LLM crawlers read this)
// ------------------------------------------------------------------
const person = {
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: t.meta.name,
  alternateName: 'Mohamed Mortahil',
  jobTitle: t.meta.role,
  description: t.meta.description,
  url: canonical,
  email: `mailto:${EMAIL}`,
  telephone: '+34 632 15 94 01',
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Talavera de la Reina',
    addressRegion: 'Toledo',
    addressCountry: 'ES',
  },
  knowsLanguage: ['es', 'en', 'ar'],
  knowsAbout: [
    'Laravel',
    'Vue.js',
    'Nuxt',
    'Inertia.js',
    'MySQL',
    'PHP',
    'TypeScript',
    'Tailwind CSS',
    'Algolia',
    'Stripe',
    'OpenAI API',
    'AWS S3',
    'Linux',
    'Apache',
    'Full Stack Development',
    'Applied AI',
    'Cloud',
  ],
  alumniOf: { '@type': 'Organization', name: 'Cysval Consultoría y Servicios' },
  worksFor: { '@type': 'Organization', name: 'Ulandu' },
  sameAs: ['https://www.linkedin.com/in/mohamedmortahil'],
};

const website = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  url: canonical,
  name: t.meta.name,
  inLanguage: lang,
  publisher: { '@id': `${SITE_URL}/#person` },
};

const profilePage = {
  '@type': 'ProfilePage',
  '@id': `${canonical}#profilepage`,
  url: canonical,
  inLanguage: lang,
  mainEntity: { '@id': `${SITE_URL}/#person` },
  dateModified: import.meta.env.BUILD_DATE ?? undefined,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, website, profilePage],
};
---

<!doctype html>
<html lang={lang} class="has-cursor">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={t.meta.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- The three faces used above the fold. Without these the woff2 requests
         only start once the stylesheet has parsed and the @font-face matched,
         which serialises font download behind CSS. `crossorigin` is required
         even same-origin: font fetches are always CORS-mode. -->
    <link rel="preload" href={clashDisplay600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={spaceGroteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMonoLatin} as="font" type="font/woff2" crossorigin />

    <!-- Canonical + hreflang (x-default points to the primary language) -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={other} href={alternateHref} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={t.meta.name} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:locale:alternate" content={locale === 'es' ? 'en_GB' : 'es_ES'} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured data: Person + WebSite + ProfilePage -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />

    <div class="grain" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true" data-cursor-ring></div>
    <div class="cursor-dot" aria-hidden="true" data-cursor-dot></div>

    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
